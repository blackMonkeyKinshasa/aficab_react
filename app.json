{
  "expo": {
    "name": "Aficab",
    "slug": "Aficab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/aficab-app-logo-white.png",
    "scheme": "aficab",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/aficab-app-logo-white.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/aficab-app-logo-white.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/aficab-app-logo-white.png"
    },
    "plugins": ["expo-router",[
        "expo-image-picker",
        {
          "cameraPermission": "Autoriser l'accès à la caméra",
          "photosPermission": "Autoriser l'accès aux photos"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
    
  }
}
