{
  "expo": {
    "name": "Aficab",
    "slug": "Aficab",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/aficab-app-logo-white.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/aficab-app-logo-white.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "dark": {
        "image": "./assets/images/aficab-app-logo-white.png",
        "backgroundColor": "#ffffff",
        "resizeMode": "contain"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:aficab.com",
        "applinks:www.aficab.com"
      ],
      "supportsTablet": true,
      "buildNumber": "126",
      "bundleIdentifier": "io.kinvtc.mapstracking",
      "infoPlist": {
        "NSCameraUsageDescription": "Autoriser l'acces a la camera pour prendre des photos.",
        "NSPhotoLibraryUsageDescription": "Autoriser l'acces a la galerie pour selectionner des photos.",
        "NSPhotoLibraryAddUsageDescription": "Autoriser l'enregistrement de photos dans la galerie.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/aficab-app-logo-white.png",
        "backgroundColor": "#ffffff"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "aficab.com"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "mobile",
              "host": "aficab.com"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.aficab.com"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "http",
              "host": "aficab.com",
              "pathPrefix": "/redirect"
            },
            {
              "scheme": "https",
              "host": "aficab.com",
              "pathPrefix": "/redirect"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "versionCode": 122,
      "package": "io.kinvtc.mapstracking",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/aficab-app-logo-white.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/aficab-app-logo-white.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/aficab-app-logo-white.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Autoriser l'accès à la caméra",
          "photosPermission": "Autoriser l'accès aux photos"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "aficab",
          "project": "aficab-mobile"
        }
      ],
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e4903418-da7d-4c7b-b1f4-775a13059867"
      }
    },
    "owner": "castello6505"
  }
}
